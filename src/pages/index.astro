		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
		<Analytics />
		<title>Texas Turf Maintenance - #1 Artificial Turf Maintenance Across Texas | Statewide Sports Field Experts</title>
		<meta name="description" content="Professional artificial turf maintenance across Texas. Expert cleaning, infill replacement, seam repair for football, soccer & baseball fields in Dallas, Houston, Austin, San Antonio. Get a free quote!" />
		<meta name="keywords" content="artificial turf maintenance texas, synthetic turf cleaning houston dallas austin, sports field maintenance statewide, turf repair san antonio, artificial grass cleaning texas" />
		<link rel="canonical" href="https://texasturfmaintenance.com/" />
		
		<!-- Preload critical resources -->
		<link rel="preload" href="/_astro/critical.css" as="style" onload="this.onload=null;this.rel='stylesheet'">

		<!-- Resource hints for performance -->
		<link rel="prefetch" href="/services">
		<link rel="prefetch" href="/contact">
		
		<!-- Critical CSS - Above the fold content -->
		<style>
			/* Critical CSS - Reset and base styles */
			*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
			body{font-family:'Montserrat',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;line-height:1.6;color:#111111;font-display:swap}
			
			/* Critical - Navigation */
			nav{background:#123E2A;padding:1rem 0;position:sticky;top:0;z-index:100;contain:layout style paint}
			.nav-container{max-width:1200px;margin:0 auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center}
			.logo{font-size:1.5rem;font-weight:700;color:#fff;text-decoration:none}
			.nav-links{display:flex;list-style:none;gap:2rem;margin:0}
			.nav-links a{color:#fff;text-decoration:none;transition:color .3s ease}
			.nav-links a:hover,.nav-links a.active{color:#3FAE49}
			
			/* Critical - Hero section (LCP element) */
			.hero{background:linear-gradient(rgba(10,10,10,0.6),rgba(10,10,10,0.93)),url('/images/sports-complex-aerial-view-optimized.jpg');background-size:cover;background-position:center;color:#fff;padding:9rem 0 7rem;text-align:center;contain:layout style paint;border-bottom:4px solid #3FAE49}
			.hero-content{max-width:820px;margin:0 auto;padding:0 20px}
			.hero-eyebrow{font-size:0.8rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#3FAE49;margin-bottom:1.25rem}
			.hero h1{font-size:clamp(2.3rem,5.5vw,3.6rem);margin-bottom:1.25rem;font-weight:800;line-height:1.08;letter-spacing:-0.02em}
			.hero-subtitle{font-size:clamp(1rem,3vw,1.2rem);margin-bottom:2rem;opacity:.92}
			.hero-buttons{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem}

			/* Critical - Button styles */
			.btn-primary,.btn-secondary{display:inline-block;padding:1rem 2.25rem;text-decoration:none;border-radius:4px;font-weight:700;transition:all .2s ease;text-align:center;min-width:140px;text-transform:uppercase;font-size:0.9rem;letter-spacing:0.04em}
			.btn-primary{background:#3FAE49;color:#fff}
			.btn-primary:hover{background:#2F8C38}
			.btn-secondary{background:transparent;color:#fff;border:2px solid #fff}
			.btn-secondary:hover{background:#fff;color:#123E2A}
			
			/* Critical - Container */
			.container{max-width:1200px;margin:0 auto;padding:0 20px}
			
			/* Critical - Mobile responsiveness */
			@media (max-width:768px){
				.nav-container{flex-direction:column;gap:1rem}
				.nav-links{flex-wrap:wrap;justify-content:center;gap:1rem}
				.hero{padding:4rem 0}
				.hero-buttons{flex-direction:column;align-items:center;gap:.5rem}
				.btn-primary,.btn-secondary{width:100%;max-width:280px}
			}
		</style>
		
