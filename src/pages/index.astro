							<span>Reliable &amp; Efficient</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Core Services Section -->
			<section class="core-services">
				<div class="container">
					<div class="services-header">
						<p class="eyebrow">What We Do</p>
						<h2>Professional Artificial Turf Maintenance Services</h2>
						<p class="services-subtitle">Expert maintenance for sports fields, commercial properties, and recreational facilities across Texas</p>
					</div>

					<div class="services-grid">
						<div class="service-row">
							<span class="service-num">01</span>
							<div class="service-icon"><Icon name="stripes" size={26} /></div>
							<div class="service-copy">
								<h3>Turf Grooming &amp; Brushing</h3>
								<p>Professional grooming to maintain proper fiber height and playing surface performance. Recommended every 150-200 hours of use for optimal field conditions.</p>
								<a href="/services" class="service-link">Learn More →</a>
							</div>
						</div>

						<div class="service-row">
							<span class="service-num">02</span>
							<div class="service-icon"><Icon name="spray" size={26} /></div>
							<div class="service-copy">
								<h3>Deep Cleaning &amp; Sanitization</h3>
								<p>Industrial-grade cleaning to remove dirt, debris, organic matter, and bacteria. Specialized equipment and eco-friendly solutions for safe, thorough results.</p>
								<a href="/services" class="service-link">Learn More →</a>
							</div>
						</div>

						<div class="service-row">
							<span class="service-num">03</span>
							<div class="service-icon"><Icon name="layers" size={26} /></div>
							<div class="service-copy">
								<h3>Infill Replacement &amp; Leveling</h3>
								<p>Complete infill refresh, cleaning, and precision leveling. Restores proper drainage, shock absorption, and playing surface characteristics.</p>
								<a href="/services" class="service-link">Learn More →</a>
							</div>
						</div>

						<div class="service-row">
							<span class="service-num">04</span>
							<div class="service-icon"><Icon name="gauge" size={26} /></div>
							<div class="service-copy">
								<h3>GMAX Safety Testing</h3>
								<p>Professional GMAX impact testing for sports field safety compliance. Required for many athletic programs and insurance requirements.</p>
								<a href="/gmax-testing-dallas" class="service-link">Learn More →</a>
							</div>
						</div>

						<div class="service-row">
							<span class="service-num">05</span>
							<div class="service-icon"><Icon name="scissors" size={26} /></div>
							<div class="service-copy">
								<h3>Seam Repair &amp; Restoration</h3>
								<p>Expert repair of damaged seams, tears, and worn areas. Professional-grade materials and techniques ensure long-lasting, safe playing surfaces.</p>
								<a href="/services" class="service-link">Learn More →</a>
							</div>
						</div>

						<div class="service-row">
							<span class="service-num">06</span>
							<div class="service-icon"><Icon name="stripes" size={26} /></div>
							<div class="service-copy">
								<h3>Line Striping &amp; Marking</h3>
								<p>Precision line striping for football, soccer, baseball, and multi-sport fields. Professional equipment for crisp, durable field markings.</p>
								<a href="/services" class="service-link">Learn More →</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="we-serve">
