	<body>
		<Nav active="home" />

		<main>
			<section class="hero">
				<div class="hero-content">
					<p class="hero-eyebrow">Texas &middot; Sports Fields &middot; Commercial Properties</p>
					<h1>Professional Artificial Turf Maintenance</h1>
					<p class="hero-subtitle">Expert cleaning, repair, and restoration for artificial turf sports fields — proudly serving Dallas-Fort Worth, Houston, Austin, San Antonio and communities across Texas</p>
					<div class="hero-buttons">
						<a href="/contact" class="btn-primary">Get Free Quote</a>
						<a href="/football-field-turf-maintenance" class="btn-secondary">Football Field Maintenance</a>
					</div>
				</div>
			</section>

