		</footer>

		<!-- Non-critical CSS loaded asynchronously -->
		<style media="print" onload="this.media='all';this.onload=null;">
			/* Shared eyebrow label */
			.eyebrow{font-size:0.78rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#3FAE49;margin-bottom:0.75rem;text-align:center}
			.eyebrow-light{color:#3FAE49}

			/* Trust bar */
			.trust-bar{background:#111111;padding:2rem 0;border-bottom:1px solid #2E332F}
			.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem}
			.trust-item{display:flex;flex-direction:column;align-items:center;gap:0.6rem;color:#fff;text-align:center}
			.trust-item svg{color:#3FAE49}
