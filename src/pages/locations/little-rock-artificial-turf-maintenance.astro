---
import Analytics from '../../components/Analytics.astro';
import Nav from '../../components/Nav.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<Analytics />
		<title>Little Rock Artificial Turf Maintenance | Sports Field Care | Texas Turf Maintenance</title>
		<meta name="description" content="Professional artificial turf maintenance in Little Rock, AR. Deep cleaning, infill replacement, and GMAX safety testing for football, soccer, and baseball fields across Central Arkansas." />
		<meta name="keywords" content="Little Rock artificial turf maintenance, synthetic turf cleaning Little Rock, sports field maintenance Arkansas, turf repair Little Rock, GMAX testing Little Rock, Conway turf maintenance, North Little Rock artificial turf" />
		<link rel="canonical" href="https://texasturfmaintenance.com/locations/little-rock-artificial-turf-maintenance" />

		<!-- Local Business Schema -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"@id": "https://texasturfmaintenance.com/locations/little-rock-artificial-turf-maintenance#organization",
			"name": "Texas Turf Maintenance - Little Rock",
			"alternateName": "Little Rock Artificial Turf Professionals",
			"description": "Professional artificial turf maintenance services for sports fields in Little Rock and Central Arkansas, serviced from our Dallas, TX base",
			"url": "https://texasturfmaintenance.com/locations/little-rock-artificial-turf-maintenance",
			"telephone": "+14699819247",
			"email": "andrew@texasturfmaintenance.com",
			"priceRange": "$0.50-$2.00",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Dallas",
				"addressRegion": "TX",
				"addressCountry": "US",
				"postalCode": "75201"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": "32.7767",
				"longitude": "-96.7970"
			},
			"areaServed": [
				{ "@type": "City", "name": "Little Rock", "addressRegion": "AR" },
				{ "@type": "City", "name": "North Little Rock", "addressRegion": "AR" },
				{ "@type": "City", "name": "Conway", "addressRegion": "AR" },
				{ "@type": "City", "name": "Benton", "addressRegion": "AR" },
				{ "@type": "City", "name": "Bryant", "addressRegion": "AR" }
			],
			"serviceArea": {
				"@type": "GeoCircle",
				"geoMidpoint": { "@type": "GeoCoordinates", "latitude": "32.7767", "longitude": "-96.7970" },
				"geoRadius": "400"
			},
			"openingHours": ["Mo-Fr 07:00-18:00", "Sa 08:00-16:00"],
			"services": [
				"Artificial Turf Deep Cleaning",
				"Infill Replacement & Leveling",
				"GMAX Safety Testing",
				"Seam Repair & Restoration",
				"Preventive Maintenance Programs"
			]
		}
		</script>

		<link rel="prefetch" href="/contact">

		<!-- Critical CSS -->
		<style>
			*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
			body{font-family:'Montserrat',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;line-height:1.6;color:#111111;font-display:swap}
			.hero{background:linear-gradient(rgba(17,17,17,0.7),rgba(17,17,17,0.88)),url('/images/sports-complex-aerial-view-optimized.jpg');background-size:cover;background-position:center;color:#fff;padding:8rem 0;text-align:center}
			.hero h1{font-size:clamp(2rem,5vw,3.5rem);margin-bottom:1rem;font-weight:700;line-height:1.2}
			.hero-subtitle{font-size:clamp(1rem,3vw,1.3rem);margin-bottom:2rem;opacity:.9;max-width:800px;margin-left:auto;margin-right:auto}
			.container{max-width:1200px;margin:0 auto;padding:0 20px}
			.btn-primary{background:#3FAE49;color:#fff;padding:1rem 2rem;text-decoration:none;border-radius:5px;font-weight:700;transition:all .3s ease;display:inline-block;box-shadow:0 2px 8px rgba(63,174,73,0.3)}
			.btn-primary:hover{background:#2F8C38;transform:translateY(-2px);box-shadow:0 4px 12px rgba(63,174,73,0.4)}
			.btn-secondary{background:transparent;color:#fff;border:2px solid #fff;padding:1rem 2rem;text-decoration:none;border-radius:5px;font-weight:700;transition:all .3s ease;display:inline-block}
			.btn-secondary:hover{background:#fff;color:#123E2A}
			.hero-buttons{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem}
			@media (max-width:768px){.hero{padding:4rem 0}}
		</style>
	</head>
	<body>
		<Nav active="locations" />

		<main>
			<section class="hero">
				<div class="container">
					<h1>Little Rock Artificial Turf Maintenance</h1>
					<p class="hero-subtitle">Professional artificial turf cleaning, repair, and safety testing for sports fields across Central Arkansas — serviced from our Dallas, TX base, about 5.5 hours northeast</p>
					<div class="hero-buttons">
						<a href="/contact?location=little-rock" class="btn-primary">Get Free Little Rock Quote</a>
						<a href="tel:+14699819247" class="btn-secondary">Call (469) 981-9247</a>
					</div>
				</div>
			</section>

			<section class="expansion-note">
				<div class="container">
					<p>Little Rock is part of Texas Turf Maintenance's expansion beyond Texas. As one of the farther stops on our route, we schedule visits here well in advance — reach out early in your maintenance season so we can build your field in.</p>
				</div>
			</section>

			<section class="regional-challenges">
				<div class="container">
					<h2>Little Rock's Turf Maintenance Challenges</h2>
					<p class="section-intro">The Arkansas River Valley's humid climate and true winter weather create demands most Texas fields never face.</p>

					<div class="challenges-grid">
						<div class="challenge-item">
							<h3>Humid, Muggy Summers</h3>
							<p>Central Arkansas summers combine high heat with heavy humidity, speeding up organic buildup and bacterial growth. We schedule deep-cleaning and antimicrobial treatment more frequently during peak season.</p>
						</div>
						<div class="challenge-item">
							<h3>Heavy Pollen Loads</h3>
							<p>Little Rock's oak and pine tree cover produces some of the heaviest spring pollen in the region. Regular grooming and cleaning prevent pollen from staining light-colored infill and clogging drainage.</p>
						</div>
						<div class="challenge-item">
							<h3>Winter Ice Storms</h3>
							<p>Arkansas sees more freezing rain and ice events than Texas. We advise on turf-safe ice removal and inspect for infill compaction after freeze-thaw cycles.</p>
						</div>
						<div class="challenge-item">
							<h3>Spring Severe Weather</h3>
							<p>Central Arkansas sits at the edge of "Dixie Alley," with its own tornado and severe storm season. We prioritize storm-damage inspections for affected fields on the next scheduled visit.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="service-areas">
				<div class="container">
					<h2>Central Arkansas Coverage</h2>
					<p class="section-intro">Serving Little Rock, North Little Rock, and the surrounding metro</p>
					<div class="areas-grid">
						<div class="area-group">
							<h3>Little Rock</h3>
							<ul class="zip-list">
								<li>Downtown Little Rock (72201)</li>
								<li>West Little Rock (72211, 72223)</li>
							</ul>
						</div>
						<div class="area-group">
							<h3>North Little Rock</h3>
							<ul class="zip-list">
								<li>North Little Rock (72114, 72116)</li>
							</ul>
						</div>
						<div class="area-group">
							<h3>Surrounding Communities</h3>
							<ul class="zip-list">
								<li>Conway (72032)</li>
								<li>Benton (72015)</li>
								<li>Bryant (72022)</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<section class="facility-types">
				<div class="container">
					<h2>Facilities We Serve</h2>
					<div class="facility-grid">
						<div class="facility-item">
							<h3>School District Fields</h3>
							<p>Comprehensive maintenance and GMAX safety testing for high school and youth athletic fields across Central Arkansas.</p>
						</div>
						<div class="facility-item">
							<h3>Municipal &amp; Youth Sports Complexes</h3>
							<p>Cost-effective maintenance programs for city-run parks, recreation departments, and multi-field youth sports complexes.</p>
						</div>
						<div class="facility-item">
							<h3>Private Training Facilities</h3>
							<p>Detail-oriented care for indoor training centers and specialized athletic academies throughout the region.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="cta">
				<div class="container">
					<h2>Ready to Maintain Your Little Rock-Area Field?</h2>
					<p>Get a free consultation and quote for artificial turf maintenance in Little Rock and Central Arkansas.</p>
					<div class="cta-buttons">
						<a href="/contact?location=little-rock&service=consultation" class="btn-primary">Schedule Free Little Rock Assessment</a>
						<a href="tel:+14699819247" class="btn-secondary">Call (469) 981-9247</a>
					</div>
				</div>
			</section>
		</main>

		<footer>
			<div class="container">
				<div class="footer-content">
					<div class="footer-section">
						<h3>Texas Turf Maintenance</h3>
						<p class="footer-tagline">Clean. Safe. Game Ready.</p>
						<p>Serving Little Rock and Central Arkansas from our Dallas, TX base as part of our regional expansion.</p>
					</div>
					<div class="footer-section">
						<h3>Services</h3>
						<ul>
							<li><a href="/services">Deep Cleaning</a></li>
							<li><a href="/services">Infill Replacement</a></li>
							<li><a href="/gmax-testing-dallas">GMAX Safety Testing</a></li>
							<li><a href="/services">Maintenance Plans</a></li>
						</ul>
					</div>
					<div class="footer-section">
						<h3>Little Rock Service Areas</h3>
						<ul>
							<li>Little Rock</li>
							<li>North Little Rock</li>
							<li>Conway</li>
							<li>Benton &amp; Bryant</li>
						</ul>
					</div>
					<div class="footer-section">
						<h3>Contact</h3>
						<p>Phone: (469) 981-9247</p>
						<p>Email: andrew@texasturfmaintenance.com</p>
					</div>
				</div>
			</div>
		</footer>

		<!-- Non-critical CSS -->
		<style media="print" onload="this.media='all';this.onload=null;">
			.expansion-note{background:#E5E7E9;padding:1.5rem 0}
			.expansion-note p{max-width:800px;margin:0 auto;text-align:center;color:#111111;font-size:0.98rem}
			.regional-challenges,.service-areas,.facility-types{padding:6rem 0}
			.regional-challenges{background:#fff}
			.regional-challenges h2,.service-areas h2,.facility-types h2{text-align:center;margin-bottom:1rem;font-size:clamp(2rem,4vw,2.5rem);color:#123E2A}
			.section-intro{text-align:center;font-size:1.1rem;color:#6B6F72;margin-bottom:3rem;max-width:700px;margin-left:auto;margin-right:auto}
			.challenges-grid,.areas-grid,.facility-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2rem;margin-top:2rem}
			.challenge-item,.facility-item{background:#F8F9FA;padding:2rem;border-radius:10px;border:1px solid #E5E7E9}
			.challenge-item h3,.facility-item h3{color:#111111;margin-bottom:1rem;font-size:1.2rem;font-weight:600}
			.challenge-item p,.facility-item p{color:#6B6F72;line-height:1.6}
			.service-areas{background:#F8F9FA}
			.area-group{background:#fff;padding:1.5rem;border-radius:10px;border:1px solid #E5E7E9}
			.area-group h3{color:#123E2A;margin-bottom:1rem;font-size:1.2rem;text-align:center}
			.zip-list{list-style:none;color:#111111}
			.zip-list li{padding:0.4rem 0;border-bottom:1px solid #E5E7E9;font-size:0.92rem}
			.zip-list li:last-child{border-bottom:none}
			.cta{background:#111111;color:#fff;padding:6rem 0;text-align:center}
			.cta h2{margin-bottom:1rem;font-size:clamp(2rem,4vw,2.5rem)}
			.cta p{margin-bottom:2rem;font-size:clamp(1rem,2vw,1.1rem);max-width:600px;margin-left:auto;margin-right:auto}
			.cta-buttons{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
			.cta .btn-secondary{color:#fff;border-color:#fff}
			.cta .btn-secondary:hover{background:#fff;color:#123E2A}
			footer{background:#111111;color:#fff;padding:3rem 0}
			.footer-content{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2rem}
			.footer-section h3{margin-bottom:0.5rem;color:#fff}
			.footer-tagline{color:#3FAE49;font-weight:600;letter-spacing:0.04em;margin-bottom:0.75rem;font-size:0.85rem;text-transform:uppercase}
			.footer-section ul{list-style:none}
			.footer-section ul li{margin-bottom:0.5rem}
			.footer-section a{color:#ccc;text-decoration:none;transition:color .3s ease}
			.footer-section a:hover{color:#3FAE49}
			@media (max-width:768px){
				.regional-challenges,.service-areas,.facility-types{padding:4rem 0}
				.challenges-grid,.areas-grid,.facility-grid{grid-template-columns:1fr}
				.cta-buttons{flex-direction:column;align-items:center}
				.btn-primary,.btn-secondary{width:100%;max-width:280px}
			}
		</style>
	</body>
</html>
