---
import Analytics from '../../components/Analytics.astro';
import Nav from '../../components/Nav.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<Analytics />
		<title>Shreveport Artificial Turf Maintenance | Sports Field Care | Texas Turf Maintenance</title>
		<meta name="description" content="Professional artificial turf maintenance in Shreveport-Bossier, LA. Deep cleaning, infill replacement, and GMAX safety testing for football, soccer, and baseball fields." />
		<meta name="keywords" content="Shreveport artificial turf maintenance, synthetic turf cleaning Shreveport, sports field maintenance Louisiana, turf repair Shreveport, GMAX testing Shreveport, Bossier City turf maintenance" />
		<link rel="canonical" href="https://texasturfmaintenance.com/locations/shreveport-artificial-turf-maintenance" />

		<!-- Local Business Schema -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"@id": "https://texasturfmaintenance.com/locations/shreveport-artificial-turf-maintenance#organization",
			"name": "Texas Turf Maintenance - Shreveport",
			"alternateName": "Shreveport Artificial Turf Professionals",
			"description": "Professional artificial turf maintenance services for sports fields in Shreveport-Bossier, serviced from our Dallas, TX base",
			"url": "https://texasturfmaintenance.com/locations/shreveport-artificial-turf-maintenance",
			"telephone": "+14699819247",
			"email": "andrew@texasturfmaintenance.com",
			"priceRange": "$0.50-$2.00",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Dallas",
				"addressRegion": "TX",
				"addressCountry": "US",
				"postalCode": "75201"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": "32.7767",
				"longitude": "-96.7970"
			},
			"areaServed": [
				{ "@type": "City", "name": "Shreveport", "addressRegion": "LA" },
				{ "@type": "City", "name": "Bossier City", "addressRegion": "LA" },
				{ "@type": "City", "name": "Haughton", "addressRegion": "LA" },
				{ "@type": "City", "name": "Benton", "addressRegion": "LA" }
			],
			"serviceArea": {
				"@type": "GeoCircle",
				"geoMidpoint": { "@type": "GeoCoordinates", "latitude": "32.7767", "longitude": "-96.7970" },
				"geoRadius": "400"
			},
			"openingHours": ["Mo-Fr 07:00-18:00", "Sa 08:00-16:00"],
			"services": [
				"Artificial Turf Deep Cleaning",
				"Infill Replacement & Leveling",
				"GMAX Safety Testing",
				"Seam Repair & Restoration",
				"Preventive Maintenance Programs"
			]
		}
		</script>

		<link rel="prefetch" href="/contact">

		<!-- Critical CSS -->
		<style>
			*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
			body{font-family:'Montserrat',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;line-height:1.6;color:#111111;font-display:swap}
			.hero{background:linear-gradient(rgba(17,17,17,0.7),rgba(17,17,17,0.88)),url('/images/sports-complex-aerial-view-optimized.jpg');background-size:cover;background-position:center;color:#fff;padding:8rem 0;text-align:center}
			.hero h1{font-size:clamp(2rem,5vw,3.5rem);margin-bottom:1rem;font-weight:700;line-height:1.2}
			.hero-subtitle{font-size:clamp(1rem,3vw,1.3rem);margin-bottom:2rem;opacity:.9;max-width:800px;margin-left:auto;margin-right:auto}
			.container{max-width:1200px;margin:0 auto;padding:0 20px}
			.btn-primary{background:#3FAE49;color:#fff;padding:1rem 2rem;text-decoration:none;border-radius:4px;font-weight:700;transition:background .2s ease;display:inline-block;text-transform:uppercase;letter-spacing:0.04em;font-size:0.9rem;}
			.btn-primary:hover{background:#2F8C38;transform:translateY(-2px);}
			.btn-secondary{background:transparent;color:#fff;border:2px solid #fff;padding:1rem 2rem;text-decoration:none;border-radius:5px;font-weight:700;transition:all .3s ease;display:inline-block}
			.btn-secondary:hover{background:#fff;color:#123E2A}
			.hero-buttons{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem}
			@media (max-width:768px){.hero{padding:4rem 0}}
		</style>
	</head>
	<body>
		<Nav active="locations" />

		<main>
			<section class="hero">
				<div class="container">
					<h1>Shreveport Artificial Turf Maintenance</h1>
					<p class="hero-subtitle">Professional artificial turf cleaning, repair, and safety testing for sports fields across Shreveport-Bossier — serviced from our Dallas, TX base, about 3 hours east on I-20</p>
					<div class="hero-buttons">
						<a href="/contact?location=shreveport" class="btn-primary">Get Free Shreveport Quote</a>
						<a href="tel:+14699819247" class="btn-secondary">Call (469) 981-9247</a>
					</div>
				</div>
			</section>

			<section class="expansion-note">
				<div class="container">
					<p>Shreveport-Bossier is part of Texas Turf Maintenance's expansion beyond Texas. We schedule visits here in coordinated service runs from Dallas — reach out early in your maintenance season so we can build your field into the route.</p>
				</div>
			</section>

			<section class="regional-challenges">
				<div class="container">
					<h2>Shreveport's Turf Maintenance Challenges</h2>
					<p class="section-intro">Shreveport's humid, pine-forest climate is closer to East Texas than the Dallas metro, with a few demands of its own.</p>

					<div class="challenges-grid">
						<div class="challenge-item">
							<h3>Hot, Humid Summers</h3>
							<p>Shreveport's subtropical summers run hotter and more humid than Dallas, accelerating bacteria and organic matter buildup. We schedule deep-cleaning and antimicrobial treatment more frequently in peak season.</p>
						</div>
						<div class="challenge-item">
							<h3>Pine Pollen &amp; Needle Debris</h3>
							<p>Heavy pine forest cover throughout the region means significant pollen loads each spring and constant needle debris. Regular grooming keeps drainage clear and prevents staining on light-colored infill.</p>
						</div>
						<div class="challenge-item">
							<h3>Heavy Rainfall &amp; Flooding</h3>
							<p>Shreveport sees substantial annual rainfall, and fields near the Red River are prone to periodic flooding. Our drainage inspections and infill management help fields recover play-ready faster after major rain events.</p>
						</div>
						<div class="challenge-item">
							<h3>Year-Round Growing Season</h3>
							<p>Mild winters mean little seasonal break for organic growth. Consistent, scheduled maintenance visits matter more here than in areas with a true winter dormancy period.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="service-areas">
				<div class="container">
					<h2>Shreveport-Bossier Coverage</h2>
					<p class="section-intro">Serving Shreveport, Bossier City, and the surrounding Ark-La-Tex region</p>
					<div class="areas-grid">
						<div class="area-group">
							<h3>Shreveport</h3>
							<ul class="zip-list">
								<li>Downtown Shreveport (71101)</li>
								<li>South Shreveport (71105, 71106)</li>
							</ul>
						</div>
						<div class="area-group">
							<h3>Bossier City</h3>
							<ul class="zip-list">
								<li>Bossier City (71111, 71112)</li>
							</ul>
						</div>
						<div class="area-group">
							<h3>Surrounding Communities</h3>
							<ul class="zip-list">
								<li>Haughton (71037)</li>
								<li>Benton (71006)</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<section class="facility-types">
				<div class="container">
					<h2>Facilities We Serve</h2>
					<div class="facility-grid">
						<div class="facility-item">
							<h3>School District Fields</h3>
							<p>Comprehensive maintenance and GMAX safety testing for high school and youth athletic fields across the region.</p>
						</div>
						<div class="facility-item">
							<h3>Municipal &amp; Youth Sports Complexes</h3>
							<p>Cost-effective maintenance programs for city-run parks, recreation departments, and multi-field youth sports complexes.</p>
						</div>
						<div class="facility-item">
							<h3>Private Training Facilities</h3>
							<p>Detail-oriented care for indoor training centers and specialized athletic academies throughout Ark-La-Tex.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="cta">
				<div class="container">
					<h2>Ready to Maintain Your Shreveport-Area Field?</h2>
					<p>Get a free consultation and quote for artificial turf maintenance in Shreveport-Bossier and the surrounding region.</p>
					<div class="cta-buttons">
						<a href="/contact?location=shreveport&service=consultation" class="btn-primary">Schedule Free Shreveport Assessment</a>
						<a href="tel:+14699819247" class="btn-secondary">Call (469) 981-9247</a>
					</div>
				</div>
			</section>
		</main>

		<footer>
			<div class="container">
				<div class="footer-content">
					<div class="footer-section">
						<h3>Texas Turf Maintenance</h3>
						<p class="footer-tagline">Clean. Safe. Game Ready.</p>
						<p>Serving Shreveport-Bossier from our Dallas, TX base as part of our regional expansion.</p>
					</div>
					<div class="footer-section">
						<h3>Services</h3>
						<ul>
							<li><a href="/services">Deep Cleaning</a></li>
							<li><a href="/services">Infill Replacement</a></li>
							<li><a href="/gmax-testing-dallas">GMAX Safety Testing</a></li>
							<li><a href="/services">Maintenance Plans</a></li>
						</ul>
					</div>
					<div class="footer-section">
						<h3>Shreveport Service Areas</h3>
						<ul>
							<li>Shreveport</li>
							<li>Bossier City</li>
							<li>Haughton</li>
							<li>Benton</li>
						</ul>
					</div>
					<div class="footer-section">
						<h3>Contact</h3>
						<p>Phone: (469) 981-9247</p>
						<p>Email: andrew@texasturfmaintenance.com</p>
					</div>
				</div>
			</div>
		</footer>

		<!-- Non-critical CSS -->
		<style media="print" onload="this.media='all';this.onload=null;">
			.expansion-note{background:#E5E7E9;padding:1.5rem 0}
			.expansion-note p{max-width:800px;margin:0 auto;text-align:center;color:#111111;font-size:0.98rem}
			.regional-challenges,.service-areas,.facility-types{padding:6rem 0}
			.regional-challenges{background:#fff}
			.regional-challenges h2,.service-areas h2,.facility-types h2{text-align:center;margin-bottom:1rem;font-size:clamp(2rem,4vw,2.5rem);color:#123E2A}
			.section-intro{text-align:center;font-size:1.1rem;color:#6B6F72;margin-bottom:3rem;max-width:700px;margin-left:auto;margin-right:auto}
			.challenges-grid,.areas-grid,.facility-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2rem;margin-top:2rem}
			.challenge-item,.facility-item{background:#F8F9FA;padding:2rem;border-radius:4px;border:1px solid #E5E7E9}
			.challenge-item h3,.facility-item h3{color:#111111;margin-bottom:1rem;font-size:1.2rem;font-weight:600}
			.challenge-item p,.facility-item p{color:#6B6F72;line-height:1.6}
			.service-areas{background:#F8F9FA}
			.area-group{background:#fff;padding:1.5rem;border-radius:4px;border:1px solid #E5E7E9}
			.area-group h3{color:#123E2A;margin-bottom:1rem;font-size:1.2rem;text-align:center}
			.zip-list{list-style:none;color:#111111}
			.zip-list li{padding:0.4rem 0;border-bottom:1px solid #E5E7E9;font-size:0.92rem}
			.zip-list li:last-child{border-bottom:none}
			.cta{background:#111111;color:#fff;padding:6rem 0;text-align:center}
			.cta h2{margin-bottom:1rem;font-size:clamp(2rem,4vw,2.5rem)}
			.cta p{margin-bottom:2rem;font-size:clamp(1rem,2vw,1.1rem);max-width:600px;margin-left:auto;margin-right:auto}
			.cta-buttons{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
			.cta .btn-secondary{color:#fff;border-color:#fff}
			.cta .btn-secondary:hover{background:#fff;color:#123E2A}
			footer{background:#111111;color:#fff;padding:3rem 0}
			.footer-content{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2rem}
			.footer-section h3{margin-bottom:0.5rem;color:#fff}
			.footer-tagline{color:#3FAE49;font-weight:600;letter-spacing:0.04em;margin-bottom:0.75rem;font-size:0.85rem;text-transform:uppercase}
			.footer-section ul{list-style:none}
			.footer-section ul li{margin-bottom:0.5rem}
			.footer-section a{color:#ccc;text-decoration:none;transition:color .3s ease}
			.footer-section a:hover{color:#3FAE49}
			@media (max-width:768px){
				.regional-challenges,.service-areas,.facility-types{padding:4rem 0}
				.challenges-grid,.areas-grid,.facility-grid{grid-template-columns:1fr}
				.cta-buttons{flex-direction:column;align-items:center}
				.btn-primary,.btn-secondary{width:100%;max-width:280px}
			}
		</style>
	</body>
</html>
