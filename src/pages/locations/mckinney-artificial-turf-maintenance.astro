			.advantage-highlight h3{color:#123E2A;margin-bottom:1rem;font-size:1.8rem;display:flex;align-items:center;justify-content:center;gap:.5rem}
			.advantages-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2rem}
			.advantage-item{background:#fff;padding:2rem;border-radius:4px;text-align:center;border:1px solid #E5E7E9}
			.advantage-icon{margin-bottom:1rem;color:#123E2A;display:flex;align-items:center;justify-content:center}
			.advantage-item h4{color:#123E2A;margin-bottom:1rem}
			.process-container{display:grid;gap:3rem;max-width:900px;margin:0 auto}
			.process-intro{text-align:center;background:#fff;padding:3rem;border-radius:4px;border:1px solid #E5E7E9}
			.process-intro h3{color:#123E2A;margin-bottom:1rem;font-size:1.5rem}
			.process-steps{display:grid;gap:2rem}
			.process-step{display:flex;align-items:center;gap:2rem;padding:2rem;background:#fff;border-radius:4px;border:1px solid #E5E7E9}
			.step-number{background:#123E2A;color:#fff;width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:bold;flex-shrink:0}
			.step-content h4{color:#123E2A;margin-bottom:1rem}
			.testimonial-mckinney{background:#f8f9fa}
			.testimonial-showcase{display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:3rem}
			.testimonial,.community-quote{background:#fff;padding:3rem;border-radius:4px;border:1px solid #E5E7E9}
			.testimonial blockquote,.community-quote blockquote{font-size:1.1rem;color:#666;font-style:italic;margin-bottom:2rem;line-height:1.6}
			.testimonial cite,.community-quote cite{color:#123E2A;font-weight:bold}
			.priority-mckinney{background:#123E2A}
			.priority-section{color:#fff}
			.priority-section h2{margin-bottom:2rem;color:#fff;text-align:center}
			.priority-layout{display:grid;grid-template-columns:2fr 1fr;gap:3rem;align-items:start}
			.priority-info h3{margin-bottom:1rem;font-size:1.5rem}
			.priority-info p{margin-bottom:2rem;font-size:1.1rem}
			.priority-features{display:grid;gap:1.5rem}
			.priority-feature{background:rgba(255,255,255,.1);padding:1.5rem;border-radius:4px}
			.priority-feature h4{margin-bottom:.5rem}
			.priority-box{background:rgba(255,255,255,.1);padding:2rem;border-radius:4px;text-align:center}
			.priority-box h3{margin-bottom:1rem}
			.priority-phone{font-size:2.5rem;font-weight:bold;margin:1rem 0}
			.priority-phone a{color:#fff;text-decoration:none}
			.priority-box p{margin-bottom:1rem}
			.priority-support{background:rgba(255,255,255,.1);padding:1rem;border-radius:5px;font-size:.9rem}
			.cta{background:#111111;color:#fff;padding:6rem 0;text-align:center}
			.cta h2{margin-bottom:1rem;font-size:clamp(2rem,4vw,2.5rem)}
			.cta p{margin-bottom:2rem;font-size:clamp(1rem,2vw,1.1rem);max-width:600px;margin-left:auto;margin-right:auto}
			.cta-buttons{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
			.btn-primary,.btn-secondary{display:inline-block;padding:1rem 2rem;text-decoration:none;border-radius:5px;font-weight:bold;transition:all .3s ease;text-align:center;min-width:140px}
			.btn-primary{background:#fff;color:#123E2A}
			.btn-primary:hover{background:#f0f0f0;transform:translateY(-2px)}
			.btn-secondary{background:transparent;color:#fff;border:2px solid #fff}
			.btn-secondary:hover{background:#fff;color:#123E2A}
			footer{background:#111111;color:#fff;padding:3rem 0}
			.footer-content{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2rem}
			.footer-section h3{margin-bottom:0.5rem;color:#fff}.footer-tagline{color:#3FAE49;font-weight:600;letter-spacing:0.04em;margin-bottom:0.75rem;font-size:0.85rem;text-transform:uppercase}
			.footer-section ul{list-style:none}
			.footer-section ul li{margin-bottom:.5rem}
			.footer-section a{color:#ccc;text-decoration:none;transition:color .3s ease}
			.footer-section a:hover{color:#3FAE49}
			@media (max-width:768px){
				.city-stats{grid-template-columns:repeat(2,1fr)}
				.school-list{grid-template-columns:1fr}
				.youth-programs,.community-facilities{grid-template-columns:1fr}
				.advantages-list{grid-template-columns:1fr}
				.process-step{flex-direction:column;text-align:center}
				.testimonial-showcase{grid-template-columns:1fr}
				.priority-layout{grid-template-columns:1fr}
				.cta-buttons{flex-direction:column;align-items:center}
				.btn-primary,.btn-secondary{width:100%;max-width:280px}
			}
		</style>
	</body>
</html>