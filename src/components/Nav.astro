---
import '../styles/theme.css';
import { SITE_NAME, NAV_LINKS, PHONE_DISPLAY, PHONE_TEL } from '../lib/site.js';

interface Props {
	active?: string;
}

const { active = '' } = Astro.props;

function isActive(link) {
	if (link.key === active) return true;
	return (link.children ?? []).some((child) => child.key === active);
}

const phonePath = 'M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2';
---

<header class="site-header">
	<nav aria-label="Primary">
		<div class="nav-container">
			<a href="/" class="logo">
				<img src="/images/brand/01_Primary_Horizontal_Full_Color.png" alt={SITE_NAME} width="658" height="245" />
			</a>

			<ul class="nav-links" id="primary-nav">
				{NAV_LINKS.map((link) => (
					<li class={link.children ? 'has-children' : undefined}>
						<a href={link.href} class={isActive(link) ? 'active' : undefined}>
							{link.label}
							{link.children && <span class="caret" aria-hidden="true">▾</span>}
						</a>
						{link.children && (
							<ul class="dropdown">
								{link.children.map((child) => (
									<li><a href={child.href} class={child.key === active ? 'active' : undefined}>{child.label}</a></li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>

			<div class="nav-actions">
				<a href={PHONE_TEL} class="nav-phone">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phonePath} /></svg>
					<span class="nav-phone-text">
						<span class="nav-phone-label">Free quotes</span>
						<span class="nav-phone-number">{PHONE_DISPLAY}</span>
					</span>
				</a>
				<a href="/contact" class="nav-quote">Free Quote</a>
				<button type="button" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
					<span class="sr-only">Menu</span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>
			</div>
		</div>
	</nav>
</header>


<div class="mobile-cta-bar">
	<a href={PHONE_TEL} class="mobile-cta-call">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phonePath} /></svg>
		Call Now
	</a>
	<a href="/contact" class="mobile-cta-quote">Free Quote</a>
</div>

<script>
	const toggle = document.querySelector('.nav-toggle');
	const links = document.getElementById('primary-nav');

	toggle?.addEventListener('click', () => {
		const isOpen = links?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});

	// Tap-to-open dropdowns on touch/mobile, where :hover doesn't apply.
	document.querySelectorAll('.nav-links > li.has-children > a').forEach((trigger) => {
		trigger.addEventListener('click', (event) => {
			if (window.innerWidth > 1140) return;
			const parent = trigger.parentElement;
			if (parent && !parent.classList.contains('dropdown-open')) {
				event.preventDefault();
				document.querySelectorAll('.nav-links > li.has-children').forEach((li) => li.classList.remove('dropdown-open'));
				parent.classList.add('dropdown-open');
			}
		});
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--surface);
		border-top: 5px solid var(--forest-900);
		box-shadow: 0 1px 0 var(--border), 0 8px 20px -16px rgba(17, 17, 17, 0.35);
	}
	.nav-container {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 24px;
		min-height: 84px;
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.logo {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}
	.logo img {
		height: 54px;
		width: auto;
		display: block;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
	}

	.nav-links {
		display: flex;
		align-items: center;
		list-style: none;
		gap: 0.1rem;
		margin: 0 auto;
		padding: 0;
	}
	.nav-links > li {
		position: relative;
	}
	.nav-links a {
		display: block;
		position: relative;
		padding: 0.6rem 0.75rem;
		color: var(--forest-900);
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
		transition: color 0.2s ease;
	}
	.nav-links > li > a::after {
		content: '';
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0.2rem;
		height: 3px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.2s ease;
	}
	.nav-links > li > a:hover::after,
	.nav-links > li > a.active::after {
		transform: scaleX(1);
	}
	.nav-links a:hover,
	.nav-links a.active {
		color: var(--forest-900);
	}
	.caret {
		font-size: 0.7em;
		margin-left: 3px;
		color: var(--accent);
	}

	/* Desktop dropdown */
	.dropdown {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 230px;
		background: var(--forest-900);
		border-radius: 0 0 var(--radius) var(--radius);
		box-shadow: var(--shadow-lg);
		padding: 0.4rem 0;
		margin: 0;
		list-style: none;
		z-index: 10;
	}
	.has-children:hover > .dropdown,
	.has-children:focus-within > .dropdown,
	.has-children.dropdown-open > .dropdown {
		display: block;
	}
	.dropdown a {
		color: #fff;
		padding: 0.65rem 1.1rem;
		font-size: 0.8rem;
		border-left: 3px solid transparent;
	}
	.dropdown a:hover,
	.dropdown a.active {
		color: #fff;
		background: rgba(255, 255, 255, 0.06);
		border-left-color: var(--accent);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-shrink: 0;
	}
	.nav-phone {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--forest-900);
		text-decoration: none;
	}
	.nav-phone svg {
		color: var(--accent);
	}
	.nav-phone-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}
	.nav-phone-label {
		font-family: var(--font-display);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--gray-500);
	}
	.nav-phone-number {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 800;
	}
	.nav-quote {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--accent);
		color: #fff !important;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		padding: 0.9rem 1.4rem;
		border-radius: var(--radius-sm);
		transition: background 0.2s ease;
	}
	.nav-quote:hover {
		background: var(--accent-700);
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: none;
		padding: 10px 6px;
		cursor: pointer;
	}
	.nav-toggle-bar {
		width: 26px;
		height: 3px;
		background: var(--forest-900);
	}

	/* Mobile sticky call/quote bar */
	.mobile-cta-bar {
		display: none;
	}

	@media (max-width: 1140px) {
		.nav-toggle {
			display: flex;
		}
		.nav-container {
			justify-content: space-between;
		}
		.nav-links {
			display: none;
			flex-direction: column;
			align-items: stretch;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			margin: 0;
			background: var(--forest-900);
			padding: 0.5rem 0 1.25rem;
			box-shadow: 0 16px 30px rgba(0, 0, 0, 0.3);
			max-height: calc(100vh - 89px);
			overflow-y: auto;
		}
		.nav-links.open {
			display: flex;
		}
		.nav-links > li {
			width: 100%;
		}
		.nav-links a,
		.nav-links a:hover,
		.nav-links a.active {
			color: #fff;
			padding: 0.85rem 24px;
			font-size: 0.95rem;
		}
		.nav-links a.active {
			color: var(--accent-500);
		}
		.nav-links > li > a::after {
			display: none;
		}
		.dropdown {
			position: static;
			box-shadow: none;
			background: rgba(0, 0, 0, 0.15);
			border-radius: 0;
			padding: 0;
		}
		.has-children:hover > .dropdown,
		.has-children:focus-within > .dropdown {
			display: none;
		}
		.has-children.dropdown-open > .dropdown {
			display: block;
		}
		.dropdown a,
		.dropdown a:hover {
			padding: 0.7rem 24px 0.7rem 2.75rem;
			font-size: 0.85rem;
			background: transparent;
		}
	}

	@media (max-width: 720px) {
		.nav-container {
			min-height: 66px;
			padding: 0 16px;
		}
		.logo img {
			height: 42px;
		}
		.nav-phone,
		.nav-actions > .nav-quote {
			display: none;
		}
		.nav-links {
			max-height: calc(100vh - 71px);
		}
		.nav-links a,
		.nav-links a:hover,
		.nav-links a.active {
			padding-left: 16px;
			padding-right: 16px;
		}

		.mobile-cta-bar {
			display: grid;
			grid-template-columns: 1fr 1fr;
			position: fixed;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 99;
			padding-bottom: env(safe-area-inset-bottom);
			background: var(--forest-900);
			box-shadow: 0 -6px 18px rgba(0, 0, 0, 0.2);
		}
		.mobile-cta-bar a {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			min-height: 58px;
			font-family: var(--font-display);
			font-size: 0.9rem;
			font-weight: 800;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			text-decoration: none;
			color: #fff;
		}
		.mobile-cta-quote {
			background: var(--accent);
			clip-path: polygon(14px 0, 100% 0, 100% 100%, 0 100%);
		}
		:global(body) {
			padding-bottom: calc(58px + env(safe-area-inset-bottom));
		}
	}
</style>
