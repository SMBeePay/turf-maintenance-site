---
import { SITE_NAME, NAV_LINKS } from '../lib/site.js';

interface Props {
	active?: string;
}

const { active = '' } = Astro.props;
---

<nav>
	<div class="nav-container">
		<a href="/" class="logo">
			<img src="/images/brand/nav-logo-reverse-green.png" alt={SITE_NAME} width="487" height="170" />
		</a>
		<ul class="nav-links">
			{NAV_LINKS.map((link) => (
				<li><a href={link.href} class={link.key === active ? 'active' : undefined}>{link.label}</a></li>
			))}
		</ul>
	</div>
</nav>

<style>
	/* Brand colors (see BRAND in src/lib/site.js) are literal hex here and
	   across the site's page-level styles rather than CSS custom properties —
	   a future cleanup, not required for this rebrand pass. */
	nav {
		background: #123E2A;
		padding: 1rem 0;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.logo {
		display: flex;
		align-items: center;
	}
	.logo img {
		height: 44px;
		width: auto;
		display: block;
	}
	.nav-links {
		display: flex;
		list-style: none;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
	}
	.nav-links a {
		color: #fff;
		text-decoration: none;
		transition: color 0.3s ease;
	}
	.nav-links a:hover,
	.nav-links a.active {
		color: #3FAE49;
	}
	@media (max-width: 768px) {
		.nav-container {
			flex-direction: column;
			gap: 1rem;
		}
		.nav-links {
			justify-content: center;
			gap: 1rem;
		}
	}
</style>
