---
import { SITE_NAME, NAV_LINKS } from '../lib/site.js';

interface Props {
	active?: string;
}

const { active = '' } = Astro.props;
---

<nav>
	<div class="nav-container">
		<a href="/" class="logo">{SITE_NAME}</a>
		<ul class="nav-links">
			{NAV_LINKS.map((link) => (
				<li><a href={link.href} class={link.key === active ? 'active' : undefined}>{link.label}</a></li>
			))}
		</ul>
	</div>
</nav>

<style>
	nav {
		background: #2c5530;
		padding: 1rem 0;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.logo {
		font-size: 1.5rem;
		font-weight: 700;
		color: #fff;
		text-decoration: none;
	}
	.nav-links {
		display: flex;
		list-style: none;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
	}
	.nav-links a {
		color: #fff;
		text-decoration: none;
		transition: color 0.3s ease;
	}
	.nav-links a:hover,
	.nav-links a.active {
		color: #4CAF50;
	}
	@media (max-width: 768px) {
		.nav-container {
			flex-direction: column;
			gap: 1rem;
		}
		.nav-links {
			justify-content: center;
			gap: 1rem;
		}
	}
</style>
